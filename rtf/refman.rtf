void aeb_control (bool *  {\i enable_aeb}, bool *  {\i alarm_cluster}, bool *  {\i enable_breaking}, bool *  {\i lk_seatbelt}, bool *  {\i lk_doors}, double *  {\i spd}, double *  {\i dist}, double *  {\i acel})}}
