01161 {\cf18 void} UnityAssertWithinDoubleArray({\cf17 const} UNITY_DOUBLE delta,\par
01162                                   UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_DOUBLE* expected,\par
01163                                   UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_DOUBLE* actual,\par
01164                                   {\cf17 const} UNITY_UINT32 num_elements,\par
01165                                   {\cf17 const} {\cf18 char}* msg,\par
01166                                   {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
01167                                   {\cf17 const} UNITY_FLAGS_T flags)\par
01168 \{\par
01169     UNITY_UINT32 elements = num_elements;\par
01170     UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_DOUBLE* ptr_expected = expected;\par
01171     UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_DOUBLE* ptr_actual = actual;\par
