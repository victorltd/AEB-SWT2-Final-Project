00041 {\cf21 #include <limits.h>}\par
00042 {\cf21 #endif}\par
00043 \par
00044 {\cf21 #if defined(__GNUC__) || defined(__clang__)}\par
00045 {\cf21   #define UNITY_FUNCTION_ATTR(a)    __attribute__((a))}\par
00046 {\cf21 #else}\par
00047 {\cf21   #define UNITY_FUNCTION_ATTR(a)    }{\cf20 /* ignore */}{\cf21 }\par
00048 {\cf21 #endif}\par
00049 \par
00050 {\cf20 /* UNITY_NORETURN is only required if we have setjmp.h. */}\par
00051 {\cf21 #ifndef UNITY_EXCLUDE_SETJMP_H}\par
00052 {\cf21   #ifndef UNITY_NORETURN}\par
00053 {\cf21     #if defined(__cplusplus)}\par
00054 {\cf21       #if __cplusplus >= 201103L}\par
00055 {\cf21         #define UNITY_NORETURN [[ noreturn ]]}\par
00056 {\cf21       #endif}\par
00057 {\cf21     #elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L && __STDC_VERSION__ < 202311L}\par
00058       {\cf20 /* _Noreturn keyword is used from C11 but deprecated in C23. */}\par
00059 {\cf21       #if defined(_WIN32) && defined(_MSC_VER)}\par
00060         {\cf20 /* We are using MSVC compiler on Windows platform. */}\par
00061         {\cf20 /* Not all Windows SDKs supports <stdnoreturn.h>, but compiler can support C11: */}\par
00062         {\cf20 /* https://devblogs.microsoft.com/cppblog/c11-and-c17-standard-support-arriving-in-msvc/ */}\par
00063         {\cf20 /* Not sure, that Mingw compilers has Windows SDK headers at all. */}\par
00064 {\cf21         #include <sdkddkver.h>}\par
00065 {\cf21       #endif}\par
00066 \par
00067       {\cf20 /* Using Windows SDK predefined macro for detecting supported SDK with MSVC compiler. */}\par
00068       {\cf20 /* Mingw GCC should work without that fixes. */}\par
00069       {\cf20 /* Based on: */}\par
00070       {\cf20 /* https://docs.microsoft.com/en-us/cpp/porting/modifying-winver-and-win32-winnt?view=msvc-170 */}\par
00071       {\cf20 /* NTDDI_WIN10_FE is equal to Windows 10 SDK 2104 */}\par
00072 {\cf21       #if defined(_MSC_VER) && ((!defined(NTDDI_WIN10_FE)) || WDK_NTDDI_VERSION < NTDDI_WIN10_FE)}\par
00073         {\cf20 /* Based on tests and: */}\par
00074         {\cf20 /* https://docs.microsoft.com/en-us/cpp/c-language/noreturn?view=msvc-170 */}\par
00075         {\cf20 /* https://en.cppreference.com/w/c/language/_Noreturn */}\par
00076 {\cf21         #define UNITY_NORETURN _Noreturn}\par
00077 {\cf21       #else }{\cf20 /* Using newer Windows SDK or not MSVC compiler */}{\cf21 }\par
00078 {\cf21         #if defined(__GNUC__)}\par
00079           {\cf20 /* The header <stdnoreturn.h> collides with __attribute(noreturn)__ from GCC. */}\par
00080 {\cf21           #define UNITY_NORETURN _Noreturn}\par
00081 {\cf21         #else}\par
00082 {\cf21           #include <stdnoreturn.h>}\par
00083 {\cf21           #define UNITY_NORETURN noreturn}\par
00084 {\cf21         #endif}\par
00085 {\cf21       #endif}\par
00086 {\cf21     #elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 202311L}\par
00087       {\cf20 /* Since C23, the keyword _Noreturn has been replaced by the attribute noreturn, based on: */}\par
00088       {\cf20 /* https://en.cppreference.com/w/c/language/attributes/noreturn */}\par
00089 {\cf21       #define UNITY_NORETURN [[ noreturn ]]}\par
00090 {\cf21     #endif}\par
00091 {\cf21   #endif}\par
