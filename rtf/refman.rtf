00326 {\cf21 #ifndef UNITY_EXCLUDE_FLOAT_PRINT}\par
00327 {\cf20 /*}\par
00328 {\cf20  * This function prints a floating-point value in a format similar to}\par
00329 {\cf20  * printf("%.7g") on a single-precision machine or printf("%.9g") on a}\par
00330 {\cf20  * double-precision machine.  The 7th digit won't always be totally correct}\par
00331 {\cf20  * in single-precision operation (for that level of accuracy, a more}\par
00332 {\cf20  * complicated algorithm would be needed).}\par
00333 {\cf20  */}\par
00334 {\cf18 void} UnityPrintFloat({\cf17 const} UNITY_DOUBLE input_number)\par
00335 \{\par
00336 {\cf21 #ifdef UNITY_INCLUDE_DOUBLE}\par
00337     {\cf17 static} {\cf17 const} {\cf18 int} sig_digits = 9;\par
00338     {\cf17 static} {\cf17 const} UNITY_INT32 min_scaled = 100000000;\par
00339     {\cf17 static} {\cf17 const} UNITY_INT32 max_scaled = 1000000000;\par
00340 {\cf21 #else}\par
00341     {\cf17 static} {\cf17 const} {\cf18 int} sig_digits = 7;\par
00342     {\cf17 static} {\cf17 const} UNITY_INT32 min_scaled = 1000000;\par
00343     {\cf17 static} {\cf17 const} UNITY_INT32 max_scaled = 10000000;\par
00344 {\cf21 #endif}\par
00345 \par
00346     UNITY_DOUBLE number = input_number;\par
00347 \par
00348     {\cf20 /* print minus sign (does not handle negative zero) */}\par
00349     {\cf19 if} (number < 0.0f)\par
00350     \{\par
00351         UNITY_OUTPUT_CHAR({\cf23 '-'});\par
00352         number = -number;\par
00353     \}\par
00354 \par
00355     {\cf20 /* handle zero, NaN, and +/- infinity */}\par
00356     {\cf19 if} (number == 0.0f)\par
00357     \{\par
00358         UnityPrint({\cf22 "0"});\par
00359     \}\par
00360     {\cf19 else} {\cf19 if} (UNITY_IS_NAN(number))\par
00361     \{\par
00362         UnityPrint({\cf22 "nan"});\par
00363     \}\par
00364     {\cf19 else} {\cf19 if} (UNITY_IS_INF(number))\par
00365     \{\par
00366         UnityPrint({\cf22 "inf"});\par
00367     \}\par
00368     {\cf19 else}\par
00369     \{\par
00370         UNITY_INT32 n_int = 0;\par
00371         UNITY_INT32 n;\par
00372         {\cf18 int}         exponent = 0;\par
00373         {\cf18 int}         decimals;\par
00374         {\cf18 int}         digits;\par
00375         {\cf18 char}        buf[16] = \{0\};\par
00376 \par
00377         {\cf20 /*}\par
00378 {\cf20          * Scale up or down by powers of 10.  To minimize rounding error,}\par
00379 {\cf20          * start with a factor/divisor of 10^10, which is the largest}\par
00380 {\cf20          * power of 10 that can be represented exactly.  Finally, compute}\par
00381 {\cf20          * (exactly) the remaining power of 10 and perform one more}\par
00382 {\cf20          * multiplication or division.}\par
00383 {\cf20          */}\par
00384         {\cf19 if} (number < 1.0f)\par
00385         \{\par
00386             UNITY_DOUBLE factor = 1.0f;\par
00387 \par
00388             {\cf19 while} (number < (UNITY_DOUBLE)max_scaled / 1e10f)  \{ number *= 1e10f; exponent -= 10; \}\par
00389             {\cf19 while} (number * factor < (UNITY_DOUBLE)min_scaled) \{ factor *= 10.0f; exponent--; \}\par
00390 \par
00391             number *= factor;\par
00392         \}\par
00393         {\cf19 else} {\cf19 if} (number > (UNITY_DOUBLE)max_scaled)\par
00394         \{\par
00395             UNITY_DOUBLE divisor = 1.0f;\par
00396 \par
00397             {\cf19 while} (number > (UNITY_DOUBLE)min_scaled * 1e10f)   \{ number  /= 1e10f; exponent += 10; \}\par
00398             {\cf19 while} (number / divisor > (UNITY_DOUBLE)max_scaled) \{ divisor *= 10.0f; exponent++; \}\par
00399 \par
00400             number /= divisor;\par
00401         \}\par
00402         {\cf19 else}\par
00403         \{\par
00404             {\cf20 /*}\par
00405 {\cf20              * In this range, we can split off the integer part before}\par
00406 {\cf20              * doing any multiplications.  This reduces rounding error by}\par
00407 {\cf20              * freeing up significant bits in the fractional part.}\par
00408 {\cf20              */}\par
00409             UNITY_DOUBLE factor = 1.0f;\par
00410             n_int = (UNITY_INT32)number;\par
00411             number -= (UNITY_DOUBLE)n_int;\par
00412 \par
00413             {\cf19 while} (n_int < min_scaled) \{ n_int *= 10; factor *= 10.0f; exponent--; \}\par
00414 \par
00415             number *= factor;\par
00416         \}\par
00417 \par
00418         {\cf20 /* round to nearest integer */}\par
00419         n = ((UNITY_INT32)(number + number) + 1) / 2;\par
00420 \par
00421 {\cf21 #ifndef UNITY_ROUND_TIES_AWAY_FROM_ZERO}\par
00422         {\cf20 /* round to even if exactly between two integers */}\par
00423         {\cf19 if} ((n & 1) && (((UNITY_DOUBLE)n - number) == 0.5f))\par
00424             n--;\par
00425 {\cf21 #endif}\par
00426 \par
00427         n += n_int;\par
00428 \par
00429         {\cf19 if} (n >= max_scaled)\par
00430         \{\par
00431             n = min_scaled;\par
00432             exponent++;\par
00433         \}\par
00434 \par
00435         {\cf20 /* determine where to place decimal point */}\par
00436         decimals = ((exponent <= 0) && (exponent >= -(sig_digits + 3))) ? (-exponent) : (sig_digits - 1);\par
00437         exponent += decimals;\par
00438 \par
00439         {\cf20 /* truncate trailing zeroes after decimal point */}\par
00440         {\cf19 while} ((decimals > 0) && ((n % 10) == 0))\par
00441         \{\par
00442             n /= 10;\par
00443             decimals--;\par
00444         \}\par
00445 \par
00446         {\cf20 /* build up buffer in reverse order */}\par
00447         digits = 0;\par
00448         {\cf19 while} ((n != 0) || (digits <= decimals))\par
00449         \{\par
00450             buf[digits++] = (char)({\cf23 '0'} + n % 10);\par
00451             n /= 10;\par
00452         \}\par
00453 \par
00454         {\cf20 /* print out buffer (backwards) */}\par
00455         {\cf19 while} (digits > 0)\par
00456         \{\par
00457             {\cf19 if} (digits == decimals)\par
00458             \{\par
00459                 UNITY_OUTPUT_CHAR({\cf23 '.'});\par
00460             \}\par
00461             UNITY_OUTPUT_CHAR(buf[--digits]);\par
00462         \}\par
00463 \par
00464         {\cf20 /* print exponent if needed */}\par
00465         {\cf19 if} (exponent != 0)\par
00466         \{\par
00467             UNITY_OUTPUT_CHAR({\cf23 'e'});\par
00468 \par
00469             {\cf19 if} (exponent < 0)\par
00470             \{\par
00471                 UNITY_OUTPUT_CHAR({\cf23 '-'});\par
00472                 exponent = -exponent;\par
00473             \}\par
00474             {\cf19 else}\par
00475             \{\par
00476                 UNITY_OUTPUT_CHAR({\cf23 '+'});\par
00477             \}\par
00478 \par
00479             digits = 0;\par
00480             {\cf19 while} ((exponent != 0) || (digits < 2))\par
00481             \{\par
00482                 buf[digits++] = (char)({\cf23 '0'} + exponent % 10);\par
00483                 exponent /= 10;\par
00484             \}\par
00485             {\cf19 while} (digits > 0)\par
00486             \{\par
00487                 UNITY_OUTPUT_CHAR(buf[--digits]);\par
00488             \}\par
00489         \}\par
00490     \}\par
00491 \}\par
00492 {\cf21 #endif }{\cf20 /* ! UNITY_EXCLUDE_FLOAT_PRINT */}{\cf21 }\par
