00933 {\cf18 void} UnityAssertWithinFloatArray({\cf17 const} UNITY_FLOAT delta,\par
00934                                  UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_FLOAT* expected,\par
00935                                  UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_FLOAT* actual,\par
00936                                  {\cf17 const} UNITY_UINT32 num_elements,\par
00937                                  {\cf17 const} {\cf18 char}* msg,\par
00938                                  {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
00939                                  {\cf17 const} UNITY_FLAGS_T flags)\par
00940 \{\par
00941     UNITY_UINT32 elements = num_elements;\par
00942     UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_FLOAT* ptr_expected = expected;\par
00943     UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_FLOAT* ptr_actual = actual;\par
00944     UNITY_FLOAT in_delta = delta;\par
00945     UNITY_FLOAT current_element_delta = delta;\par
00946 \par
00947     RETURN_IF_FAIL_OR_IGNORE;\par
00948 \par
00949     {\cf19 if} (elements == 0)\par
00950     \{\par
00951 {\cf21 #ifdef UNITY_COMPARE_PTRS_ON_ZERO_ARRAY}\par
00952         UNITY_TEST_ASSERT_EQUAL_PTR(expected, actual, lineNumber, msg);\par
00953 {\cf21 #else}\par
00954         UnityPrintPointlessAndBail();\par
00955 {\cf21 #endif}\par
00956     \}\par
00957 \par
00958     {\cf19 if} (UNITY_IS_INF(in_delta))\par
00959     \{\par
00960         {\cf19 return}; {\cf20 /* Arrays will be force equal with infinite delta */}\par
00961     \}\par
00962 \par
00963     {\cf19 if} (UNITY_IS_NAN(in_delta))\par
00964     \{\par
00965         {\cf20 /* Delta must be correct number */}\par
00966         UnityPrintPointlessAndBail();\par
00967     \}\par
00968 \par
00969     {\cf19 if} (expected == actual)\par
00970     \{\par
00971         {\cf19 return}; {\cf20 /* Both are NULL or same pointer */}\par
00972     \}\par
00973 \par
00974     {\cf19 if} (UnityIsOneArrayNull((UNITY_INTERNAL_PTR)expected, (UNITY_INTERNAL_PTR)actual, lineNumber, msg))\par
00975     \{\par
00976         UNITY_FAIL_AND_BAIL;\par
00977     \}\par
00978 \par
00979     {\cf20 /* fix delta sign if need */}\par
00980     {\cf19 if} (in_delta < 0)\par
00981     \{\par
00982         in_delta = -in_delta;\par
00983     \}\par
00984 \par
00985     {\cf19 while} (elements--)\par
00986     \{\par
00987         current_element_delta = *ptr_expected * UNITY_FLOAT_PRECISION;\par
00988 \par
00989         {\cf19 if} (current_element_delta < 0)\par
00990         \{\par
00991             {\cf20 /* fix delta sign for correct calculations */}\par
00992             current_element_delta = -current_element_delta;\par
00993         \}\par
00994 \par
00995         {\cf19 if} (!UnityFloatsWithin(in_delta + current_element_delta, *ptr_expected, *ptr_actual))\par
00996         \{\par
00997             UnityTestResultsFailBegin(lineNumber);\par
00998             UnityPrint(UnityStrElement);\par
00999             UnityPrintNumberUnsigned(num_elements - elements - 1);\par
01000             UNITY_PRINT_EXPECTED_AND_ACTUAL_FLOAT((UNITY_DOUBLE)*ptr_expected, (UNITY_DOUBLE)*ptr_actual);\par
01001             UnityAddMsgIfSpecified(msg);\par
01002             UNITY_FAIL_AND_BAIL;\par
01003         \}\par
01004         {\cf19 if} (flags == UNITY_ARRAY_TO_ARRAY)\par
01005         \{\par
01006             ptr_expected++;\par
01007         \}\par
01008         ptr_actual++;\par
01009     \}\par
01010 \}\par
