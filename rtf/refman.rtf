00097 {\cf20 /*-------------------------------------------------------}\par
00098 {\cf20  * Guess Widths If Not Specified}\par
00099 {\cf20  *-------------------------------------------------------*/}\par
00100 \par
00101 {\cf20 /* Determine the size of an int, if not already specified.}\par
00102 {\cf20  * We cannot use sizeof(int), because it is not yet defined}\par
00103 {\cf20  * at this stage in the translation of the C program.}\par
00104 {\cf20  * Also sizeof(int) does return the size in addressable units on all platforms,}\par
00105 {\cf20  * which may not necessarily be the size in bytes.}\par
00106 {\cf20  * Therefore, infer it from UINT_MAX if possible. */}\par
00107 {\cf21 #ifndef UNITY_INT_WIDTH}\par
00108 {\cf21   #ifdef UINT_MAX}\par
00109 {\cf21     #if (UINT_MAX == 0xFFFF)}\par
00110 {\cf21       #define UNITY_INT_WIDTH (16)}\par
00111 {\cf21     #elif (UINT_MAX == 0xFFFFFFFF)}\par
00112 {\cf21       #define UNITY_INT_WIDTH (32)}\par
00113 {\cf21     #elif (UINT_MAX == 0xFFFFFFFFFFFFFFFF)}\par
00114 {\cf21       #define UNITY_INT_WIDTH (64)}\par
00115 {\cf21     #endif}\par
00116 {\cf21   #else }{\cf20 /* Set to default */}{\cf21 }\par
00117 {\cf21     #define UNITY_INT_WIDTH (32)}\par
00118 {\cf21   #endif }{\cf20 /* UINT_MAX */}{\cf21 }\par
00119 {\cf21 #endif}\par
00120 \par
00121 {\cf20 /* Determine the size of a long, if not already specified. */}\par
00122 {\cf21 #ifndef UNITY_LONG_WIDTH}\par
00123 {\cf21   #ifdef ULONG_MAX}\par
00124 {\cf21     #if (ULONG_MAX == 0xFFFF)}\par
00125 {\cf21       #define UNITY_LONG_WIDTH (16)}\par
00126 {\cf21     #elif (ULONG_MAX == 0xFFFFFFFF)}\par
00127 {\cf21       #define UNITY_LONG_WIDTH (32)}\par
00128 {\cf21     #elif (ULONG_MAX == 0xFFFFFFFFFFFFFFFF)}\par
00129 {\cf21       #define UNITY_LONG_WIDTH (64)}\par
00130 {\cf21     #endif}\par
00131 {\cf21   #else }{\cf20 /* Set to default */}{\cf21 }\par
00132 {\cf21     #define UNITY_LONG_WIDTH (32)}\par
00133 {\cf21   #endif }{\cf20 /* ULONG_MAX */}{\cf21 }\par
00134 {\cf21 #endif}\par
00135 \par
00136 {\cf20 /* Determine the size of a pointer, if not already specified. */}\par
00137 {\cf21 #ifndef UNITY_POINTER_WIDTH}\par
00138 {\cf21   #ifdef UINTPTR_MAX}\par
00139 {\cf21     #if (UINTPTR_MAX <= 0xFFFF)}\par
00140 {\cf21       #define UNITY_POINTER_WIDTH (16)}\par
00141 {\cf21     #elif (UINTPTR_MAX <= 0xFFFFFFFF)}\par
00142 {\cf21       #define UNITY_POINTER_WIDTH (32)}\par
00143 {\cf21     #elif (UINTPTR_MAX <= 0xFFFFFFFFFFFFFFFF)}\par
00144 {\cf21       #define UNITY_POINTER_WIDTH (64)}\par
00145 {\cf21     #endif}\par
00146 {\cf21   #else }{\cf20 /* Set to default */}{\cf21 }\par
00147 {\cf21     #define UNITY_POINTER_WIDTH UNITY_LONG_WIDTH}\par
00148 {\cf21   #endif }{\cf20 /* UINTPTR_MAX */}{\cf21 }\par
00149 {\cf21 #endif}\par
