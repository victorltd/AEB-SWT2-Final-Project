00150 {\cf18 void} UnityPrintLen({\cf17 const} {\cf18 char}* {\cf18 string}, {\cf17 const} UNITY_UINT32 length)\par
00151 \{\par
00152     {\cf17 const} {\cf18 char}* pch = string;\par
00153 \par
00154     {\cf19 if} (pch != NULL)\par
00155     \{\par
00156         {\cf19 while} (*pch && ((UNITY_UINT32)(pch - {\cf18 string}) < length))\par
00157         \{\par
00158             {\cf20 /* printable characters plus CR & LF are printed */}\par
00159             {\cf19 if} ((*pch <= 126) && (*pch >= 32))\par
00160             \{\par
00161                 UNITY_OUTPUT_CHAR(*pch);\par
00162             \}\par
00163             {\cf20 /* write escaped carriage returns */}\par
00164             {\cf19 else} {\cf19 if} (*pch == 13)\par
00165             \{\par
00166                 UNITY_OUTPUT_CHAR({\cf23 '\\\\'});\par
00167                 UNITY_OUTPUT_CHAR({\cf23 'r'});\par
00168             \}\par
00169             {\cf20 /* write escaped line feeds */}\par
00170             {\cf19 else} {\cf19 if} (*pch == 10)\par
00171             \{\par
