00273 {\cf18 void} UnityPrintNumberHex({\cf17 const} UNITY_UINT number, {\cf17 const} {\cf18 char} nibbles_to_print)\par
00274 \{\par
00275     {\cf18 int} nibble;\par
00276     {\cf18 char} nibbles = nibbles_to_print;\par
00277 \par
00278     {\cf19 if} (({\cf18 unsigned})nibbles > UNITY_MAX_NIBBLES)\par
00279     \{\par
00280         nibbles = UNITY_MAX_NIBBLES;\par
00281     \}\par
00282 \par
00283     {\cf19 while} (nibbles > 0)\par
00284     \{\par
00285         nibbles--;\par
00286         nibble = (int)(number >> (nibbles * 4)) & 0x0F;\par
00287         {\cf19 if} (nibble <= 9)\par
00288         \{\par
00289             UNITY_OUTPUT_CHAR(({\cf18 char})({\cf23 '0'} + nibble));\par
00290         \}\par
00291         {\cf19 else}\par
00292         \{\par
00293             UNITY_OUTPUT_CHAR(({\cf18 char})({\cf23 'A'} - 10 + nibble));\par
00294         \}\par
00295     \}\par
00296 \}\par
