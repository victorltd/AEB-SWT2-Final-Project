01896 {\cf21 #define UNITY_EXTRACT_ARG(NUMBER_T, NUMBER, LENGTH_MOD, VA, ARG_T) \\}\par
01897 {\cf21 do \{                                                               \\}\par
01898 {\cf21     switch (LENGTH_MOD)                                            \\}\par
01899 {\cf21     \{                                                              \\}\par
01900 {\cf21         case UNITY_LENGTH_MODIFIER_LONG_LONG:                      \\}\par
01901 {\cf21         \{                                                          \\}\par
01902 {\cf21             NUMBER = (NUMBER_T)va_arg(VA, long long ARG_T);        \\}\par
01903 {\cf21             break;                                                 \\}\par
01904 {\cf21         \}                                                          \\}\par
01905 {\cf21         case UNITY_LENGTH_MODIFIER_LONG:                           \\}\par
01906 {\cf21         \{                                                          \\}\par
01907 {\cf21             NUMBER = (NUMBER_T)va_arg(VA, long ARG_T);             \\}\par
01908 {\cf21             break;                                                 \\}\par
01909 {\cf21         \}                                                          \\}\par
01910 {\cf21         case UNITY_LENGTH_MODIFIER_NONE:                           \\}\par
01911 {\cf21         default:                                                   \\}\par
01912 {\cf21         \{                                                          \\}\par
01913 {\cf21             NUMBER = (NUMBER_T)va_arg(VA, ARG_T);                  \\}\par
01914 {\cf21             break;                                                 \\}\par
01915 {\cf21         \}                                                          \\}\par
01916 {\cf21     \}                                                              \\}\par
01917 {\cf21 \} while (0)}\par
