00896 {\cf21 #ifndef UNITY_EXCLUDE_FLOAT}\par
00897 {\cf20 /* Wrap this define in a function with variable types as float or double */}\par
00898 {\cf21 #define UNITY_FLOAT_OR_DOUBLE_WITHIN(delta, expected, actual, diff)                           \\}\par
00899 {\cf21     if (UNITY_IS_INF(expected) && UNITY_IS_INF(actual) && (((expected) < 0) == ((actual) < 0))) return 1;   \\}\par
00900 {\cf21     if (UNITY_NAN_CHECK) return 1;                                                            \\}\par
00901 {\cf21     (diff) = (actual) - (expected);                                                           \\}\par
00902 {\cf21     if ((diff) < 0) (diff) = -(diff);                                                         \\}\par
00903 {\cf21     if ((delta) < 0) (delta) = -(delta);                                                      \\}\par
00904 {\cf21     return !(UNITY_IS_NAN(diff) || UNITY_IS_INF(diff) || ((diff) > (delta)))}\par
00905     {\cf20 /* This first part of this condition will catch any NaN or Infinite values */}\par
00906 {\cf21 #ifndef UNITY_NAN_NOT_EQUAL_NAN}\par
00907 {\cf21   #define UNITY_NAN_CHECK UNITY_IS_NAN(expected) && UNITY_IS_NAN(actual)}\par
00908 {\cf21 #else}\par
00909 {\cf21   #define UNITY_NAN_CHECK 0}\par
00910 {\cf21 #endif}\par
00911 \par
00912 {\cf21 #ifndef UNITY_EXCLUDE_FLOAT_PRINT}\par
00913 {\cf21   #define UNITY_PRINT_EXPECTED_AND_ACTUAL_FLOAT(expected, actual) \\}\par
00914 {\cf21   do \{                                                            \\}\par
00915 {\cf21     UnityPrint(UnityStrExpected);                                 \\}\par
00916 {\cf21     UnityPrintFloat(expected);                                    \\}\par
00917 {\cf21     UnityPrint(UnityStrWas);                                      \\}\par
00918 {\cf21     UnityPrintFloat(actual);                                      \\}\par
00919 {\cf21   \} while (0)}\par
00920 {\cf21 #else}\par
00921 {\cf21   #define UNITY_PRINT_EXPECTED_AND_ACTUAL_FLOAT(expected, actual) \\}\par
00922 {\cf21     UnityPrint(UnityStrDelta)}\par
00923 {\cf21 #endif }{\cf20 /* UNITY_EXCLUDE_FLOAT_PRINT */}{\cf21 }\par
