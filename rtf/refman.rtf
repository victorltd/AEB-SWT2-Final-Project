01703 \par
01704     {\cf19 if} (flags != UNITY_ARRAY_TO_ARRAY)\par
01705     \{\par
01706         expd = ({\cf17 const} {\cf18 char}*)expected;\par
01707     \}\par
01708 \par
01709     {\cf19 do}\par
01710     \{\par
01711         act = actual[j];\par
01712         {\cf19 if} (flags == UNITY_ARRAY_TO_ARRAY)\par
01713         \{\par
01714             expd = (({\cf17 const} {\cf18 char}* {\cf17 const}*)expected)[j];\par
01715         \}\par
01716 \par
01717         {\cf20 /* if both pointers not null compare the strings */}\par
01718         {\cf19 if} (expd && act)\par
01719         \{\par
01720             {\cf19 for} (i = 0; expd[i] || act[i]; i++)\par
01721             \{\par
01722                 {\cf19 if} (expd[i] != act[i])\par
01723                 \{\par
01724                     Unity.CurrentTestFailed = 1;\par
01725                     {\cf19 break};\par
01726                 \}\par
01727             \}\par
01728         \}\par
01729         {\cf19 else}\par
01730         \{ {\cf20 /* handle case of one pointers being null (if both null, test should pass) */}\par
01731             {\cf19 if} (expd != act)\par
01732             \{\par
01733                 Unity.CurrentTestFailed = 1;\par
01734             \}\par
01735         \}\par
01736 \par
01737         {\cf19 if} (Unity.CurrentTestFailed)\par
01738         \{\par
01739             UnityTestResultsFailBegin(lineNumber);\par
01740             {\cf19 if} (num_elements > 1)\par
01741             \{\par
01742                 UnityPrint(UnityStrElement);\par
01743                 UnityPrintNumberUnsigned(j);\par
01744             \}\par
01745             UnityPrintExpectedAndActualStrings(expd, act);\par
01746             UnityAddMsgIfSpecified(msg);\par
01747             UNITY_FAIL_AND_BAIL;\par
01748         \}\par
01749     \} {\cf19 while} (++j < num_elements);\par
01750 \}\par
01751 \par
