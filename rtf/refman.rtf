00239 {\cf18 void} UnityPrintNumber({\cf17 const} UNITY_INT number_to_print)\par
00240 \{\par
00241     UNITY_UINT number = (UNITY_UINT)number_to_print;\par
00242 \par
00243     {\cf19 if} (number_to_print < 0)\par
00244     \{\par
00245         {\cf20 /* A negative number, including MIN negative */}\par
00246         UNITY_OUTPUT_CHAR({\cf23 '-'});\par
