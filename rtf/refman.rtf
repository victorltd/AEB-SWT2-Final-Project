02357 {\cf17 static} {\cf18 int} IsStringInBiggerString({\cf17 const} {\cf18 char}* longstring, {\cf17 const} {\cf18 char}* shortstring)\par
02358 \{\par
02359     {\cf17 const} {\cf18 char}* lptr = longstring;\par
02360     {\cf17 const} {\cf18 char}* sptr = shortstring;\par
02361     {\cf17 const} {\cf18 char}* lnext = lptr;\par
02362 \par
02363     {\cf19 if} (*sptr == {\cf23 '*'})\par
02364     \{\par
02365         {\cf19 return} UnityStrictMatch ? 0 : 1;\par
02366     \}\par
02367 \par
02368     {\cf19 while} (*lptr)\par
02369     \{\par
02370         lnext = lptr + 1;\par
02371 \par
02372         {\cf20 /* If they current bytes match, go on to the next bytes */}\par
02373         {\cf19 while} (*lptr && *sptr && (*lptr == *sptr))\par
02374         \{\par
02375             lptr++;\par
02376             sptr++;\par
02377 \par
02378             {\cf19 switch} (*sptr)\par
02379             \{\par
02380                 {\cf19 case} {\cf23 '*'}: {\cf20 /* we encountered a wild-card */}\par
02381                     {\cf19 return} UnityStrictMatch ? 0 : 1;\par
02382 \par
02383                 {\cf19 case} {\cf23 ','}: {\cf20 /* we encountered the end of match string */}\par
02384                 {\cf19 case} {\cf23 '"'}:\par
02385                 {\cf19 case} {\cf23 '\\''}:\par
02386                 {\cf19 case} 0:\par
02387                     {\cf19 return} (!UnityStrictMatch || (*lptr == 0)) ? 1 : 0;\par
02388 \par
02389                 {\cf19 case} {\cf23 ':'}: {\cf20 /* we encountered the end of a partial match */}\par
02390                     {\cf19 return} 2;\par
02391 \par
02392                 {\cf19 default}:\par
02393                     {\cf19 break};\par
02394             \}\par
02395         \}\par
02396 \par
02397         {\cf20 // If we didn't match and we're on strict matching, we already know we failed}\par
02398         {\cf19 if} (UnityStrictMatch)\par
02399         \{\par
02400             {\cf19 return} 0;\par
02401         \}\par
02402 \par
02403         {\cf20 /* Otherwise we start in the long pointer 1 character further and try again */}\par
02404         lptr = lnext;\par
02405         sptr = shortstring;\par
02406     \}\par
02407 \par
02408     {\cf19 return} 0;\par
02409 \}\par
02410 \par
02411 {\cf20 /*-----------------------------------------------*/}\par
02412 {\cf17 static} {\cf18 int} UnityStringArgumentMatches({\cf17 const} {\cf18 char}* str)\par
02413 \{\par
02414     {\cf18 int} retval;\par
02415     {\cf17 const} {\cf18 char}* ptr1;\par
02416     {\cf17 const} {\cf18 char}* ptr2;\par
02417     {\cf17 const} {\cf18 char}* ptrf;\par
02418 \par
02419     {\cf20 /* Go through the options and get the substrings for matching one at a time */}\par
02420     ptr1 = str;\par
02421     {\cf19 while} (ptr1[0] != 0)\par
02422     \{\par
02423         {\cf19 if} ((ptr1[0] == {\cf23 '"'}) || (ptr1[0] == {\cf23 '\\''}))\par
02424         \{\par
02425             ptr1++;\par
02426         \}\par
02427 \par
02428         {\cf20 /* look for the start of the next partial */}\par
02429         ptr2 = ptr1;\par
02430         ptrf = 0;\par
02431         {\cf19 do}\par
02432         \{\par
02433             ptr2++;\par
02434             {\cf19 if} ((ptr2[0] == {\cf23 ':'}) && (ptr2[1] != 0) && (ptr2[0] != {\cf23 '\\''}) && (ptr2[0] != {\cf23 '"'}) && (ptr2[0] != {\cf23 ','}))\par
02435             \{\par
02436                 ptrf = &ptr2[1];\par
02437             \}\par
02438         \} {\cf19 while} ((ptr2[0] != 0) && (ptr2[0] != {\cf23 '\\''}) && (ptr2[0] != {\cf23 '"'}) && (ptr2[0] != {\cf23 ','}));\par
02439 \par
02440         {\cf19 while} ((ptr2[0] != 0) && ((ptr2[0] == {\cf23 ':'}) || (ptr2[0] == {\cf23 '\\''}) || (ptr2[0] == {\cf23 '"'}) || (ptr2[0] == {\cf23 ','})))\par
02441         \{\par
02442             ptr2++;\par
02443         \}\par
02444 \par
02445         {\cf20 /* done if complete filename match */}\par
02446         retval = IsStringInBiggerString(Unity.TestFile, ptr1);\par
02447         {\cf19 if} (retval == 1)\par
02448         \{\par
02449             {\cf19 return} retval;\par
02450         \}\par
02451 \par
02452         {\cf20 /* done if testname match after filename partial match */}\par
02453         {\cf19 if} ((retval == 2) && (ptrf != 0))\par
02454         \{\par
02455             {\cf19 if} (IsStringInBiggerString(Unity.CurrentTestName, ptrf))\par
02456             \{\par
02457                 {\cf19 return} 1;\par
02458             \}\par
02459         \}\par
02460 \par
02461         {\cf20 /* done if complete testname match */}\par
02462         {\cf19 if} (IsStringInBiggerString(Unity.CurrentTestName, ptr1) == 1)\par
02463         \{\par
02464             {\cf19 return} 1;\par
02465         \}\par
02466 \par
02467         ptr1 = ptr2;\par
02468     \}\par
02469 \par
02470     {\cf20 /* we couldn't find a match for any substrings */}\par
02471     {\cf19 return} 0;\par
02472 \}\par
02473 \par
02474 {\cf20 /*-----------------------------------------------*/}\par
02475 {\cf18 int} UnityTestMatches({\cf18 void})\par
02476 \{\par
02477     {\cf20 /* Check if this test name matches the included test pattern */}\par
02478     {\cf18 int} retval;\par
02479     {\cf19 if} (UnityOptionIncludeNamed)\par
02480     \{\par
02481         retval = UnityStringArgumentMatches(UnityOptionIncludeNamed);\par
02482     \}\par
02483     {\cf19 else}\par
02484     \{\par
02485         retval = 1;\par
02486     \}\par
02487 \par
02488     {\cf20 /* Check if this test name matches the excluded test pattern */}\par
02489     {\cf19 if} (UnityOptionExcludeNamed)\par
02490     \{\par
02491         {\cf19 if} (UnityStringArgumentMatches(UnityOptionExcludeNamed))\par
02492         \{\par
02493             retval = 0;\par
02494         \}\par
02495     \}\par
02496 \par
02497     {\cf19 return} retval;\par
02498 \}\par
02499 \par
02500 {\cf21 #endif }{\cf20 /* UNITY_USE_COMMAND_LINE_ARGS */}{\cf21 }\par
02501 {\cf20 /*-----------------------------------------------*/}\par
