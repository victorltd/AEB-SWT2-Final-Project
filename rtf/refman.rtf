01974 {\cf17 static} {\cf18 void} UnityPrintFVA({\cf17 const} {\cf18 char}* format, va_list va)\par
01975 \{\par
01976     {\cf17 const} {\cf18 char}* pch = format;\par
01977     {\cf19 if} (pch != NULL)\par
01978     \{\par
01979         {\cf19 while} (*pch)\par
01980         \{\par
01981             {\cf20 /* format identification character */}\par
01982             {\cf19 if} (*pch == {\cf23 '%'})\par
01983             \{\par
01984                 pch++;\par
01985 \par
01986                 {\cf19 if} (pch != NULL)\par
01987                 \{\par
01988                     {\cf18 int} length_mod_size;\par
01989                     {\cf17 enum} UnityLengthModifier length_mod = UnityLengthModifierGet(pch, &length_mod_size);\par
01990                     pch += length_mod_size;\par
01991 \par
01992                     {\cf19 switch} (*pch)\par
01993                     \{\par
01994                         {\cf19 case} {\cf23 'd'}:\par
01995                         {\cf19 case} {\cf23 'i'}:\par
01996                             \{\par
01997                                 UNITY_INT number;\par
01998                                 UNITY_EXTRACT_ARG(UNITY_INT, number, length_mod, va, {\cf18 int});\par
01999                                 UnityPrintNumber((UNITY_INT)number);\par
02000                                 {\cf19 break};\par
02001                             \}\par
02002 {\cf21 #ifndef UNITY_EXCLUDE_FLOAT_PRINT}\par
02003                         {\cf19 case} {\cf23 'f'}:\par
02004                         {\cf19 case} {\cf23 'g'}:\par
02005                             \{\par
02006                                 {\cf17 const} {\cf18 double} number = va_arg(va, {\cf18 double});\par
02007                                 UnityPrintFloat((UNITY_DOUBLE)number);\par
02008                                 {\cf19 break};\par
02009                             \}\par
02010 {\cf21 #endif}\par
02011                         {\cf19 case} {\cf23 'u'}:\par
02012                             \{\par
02013                                 UNITY_UINT number;\par
02014                                 UNITY_EXTRACT_ARG(UNITY_UINT, number, length_mod, va, {\cf18 unsigned} {\cf18 int});\par
02015                                 UnityPrintNumberUnsigned(number);\par
02016                                 {\cf19 break};\par
02017                             \}\par
02018                         {\cf19 case} {\cf23 'b'}:\par
02019                             \{\par
02020                                 UNITY_UINT number;\par
02021                                 UNITY_EXTRACT_ARG(UNITY_UINT, number, length_mod, va, {\cf18 unsigned} {\cf18 int});\par
02022                                 {\cf17 const} UNITY_UINT mask = (UNITY_UINT)0 - (UNITY_UINT)1;\par
02023                                 UNITY_OUTPUT_CHAR({\cf23 '0'});\par
02024                                 UNITY_OUTPUT_CHAR({\cf23 'b'});\par
02025                                 UnityPrintMask(mask, number);\par
02026                                 {\cf19 break};\par
02027                             \}\par
02028                         {\cf19 case} {\cf23 'x'}:\par
02029                         {\cf19 case} {\cf23 'X'}:\par
02030                             \{\par
02031                                 UNITY_UINT number;\par
02032                                 UNITY_EXTRACT_ARG(UNITY_UINT, number, length_mod, va, {\cf18 unsigned} {\cf18 int});\par
02033                                 UNITY_OUTPUT_CHAR({\cf23 '0'});\par
02034                                 UNITY_OUTPUT_CHAR({\cf23 'x'});\par
02035                                 UnityPrintNumberHex(number, UNITY_MAX_NIBBLES);\par
02036                                 {\cf19 break};\par
02037                             \}\par
02038                         {\cf19 case} {\cf23 'p'}:\par
02039                             \{\par
02040                                 UNITY_UINT number;\par
02041                                 {\cf18 char} nibbles_to_print = 8;\par
02042                                 {\cf19 if} (UNITY_POINTER_WIDTH == 64)\par
02043                                 \{\par
02044                                     length_mod = UNITY_LENGTH_MODIFIER_LONG_LONG;\par
02045                                     nibbles_to_print = 16;\par
02046                                 \}\par
02047                                 UNITY_EXTRACT_ARG(UNITY_UINT, number, length_mod, va, {\cf18 unsigned} {\cf18 int});\par
02048                                 UNITY_OUTPUT_CHAR({\cf23 '0'});\par
02049                                 UNITY_OUTPUT_CHAR({\cf23 'x'});\par
02050                                 UnityPrintNumberHex((UNITY_UINT)number, nibbles_to_print);\par
02051                                 {\cf19 break};\par
02052                             \}\par
02053                         {\cf19 case} {\cf23 'c'}:\par
02054                             \{\par
02055                                 {\cf17 const} {\cf18 int} ch = va_arg(va, {\cf18 int});\par
02056                                 UnityPrintChar(({\cf17 const} {\cf18 char} *)&ch);\par
02057                                 {\cf19 break};\par
02058                             \}\par
02059                         {\cf19 case} {\cf23 's'}:\par
02060                             \{\par
02061                                 {\cf17 const} {\cf18 char} * {\cf18 string} = va_arg(va, {\cf17 const} {\cf18 char} *);\par
02062                                 UnityPrint({\cf18 string});\par
02063                                 {\cf19 break};\par
02064                             \}\par
02065                         {\cf19 case} {\cf23 '%'}:\par
02066                             \{\par
02067                                 UnityPrintChar(pch);\par
02068                                 {\cf19 break};\par
02069                             \}\par
02070                         {\cf19 default}:\par
02071                             \{\par
02072                                 {\cf20 /* print the unknown format character */}\par
02073                                 UNITY_OUTPUT_CHAR({\cf23 '%'});\par
02074                                 UnityPrintChar(pch);\par
02075                                 {\cf19 break};\par
02076                             \}\par
02077                     \}\par
02078                 \}\par
02079             \}\par
02080 {\cf21 #ifdef UNITY_OUTPUT_COLOR}\par
02081             {\cf20 /* print ANSI escape code */}\par
02082             {\cf19 else} {\cf19 if} ((*pch == 27) && (*(pch + 1) == {\cf23 '['}))\par
02083             \{\par
02084                 pch += UnityPrintAnsiEscapeString(pch);\par
02085                 {\cf19 continue};\par
02086             \}\par
02087 {\cf21 #endif}\par
02088             {\cf19 else} {\cf19 if} (*pch == {\cf23 '\\n'})\par
02089             \{\par
02090                 UNITY_PRINT_EOL();\par
02091             \}\par
02092             {\cf19 else}\par
02093             \{\par
02094                 UnityPrintChar(pch);\par
02095             \}\par
02096 \par
02097             pch++;\par
02098         \}\par
02099     \}\par
02100 \}\par
