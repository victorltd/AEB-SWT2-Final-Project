00299 {\cf18 void} UnityPrintMask({\cf17 const} UNITY_UINT mask, {\cf17 const} UNITY_UINT number)\par
00300 \{\par
00301     UNITY_UINT current_bit = (UNITY_UINT)1 << (UNITY_INT_WIDTH - 1);\par
00302     UNITY_INT32 i;\par
00303 \par
00304     {\cf19 for} (i = 0; i < UNITY_INT_WIDTH; i++)\par
00305     \{\par
00306         {\cf19 if} (current_bit & mask)\par
00307         \{\par
00308             {\cf19 if} (current_bit & number)\par
00309             \{\par
00310                 UNITY_OUTPUT_CHAR({\cf23 '1'});\par
00311             \}\par
00312             {\cf19 else}\par
00313             \{\par
00314                 UNITY_OUTPUT_CHAR({\cf23 '0'});\par
00315             \}\par
00316         \}\par
00317         {\cf19 else}\par
00318         \{\par
00319             UNITY_OUTPUT_CHAR({\cf23 'X'});\par
00320         \}\par
00321         current_bit = current_bit >> 1;\par
00322     \}\par
00323 \}\par
