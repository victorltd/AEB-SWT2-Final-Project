01053 {\cf18 void} UnityAssertGreaterOrLessFloat({\cf17 const} UNITY_FLOAT threshold,\par
01054                                    {\cf17 const} UNITY_FLOAT actual,\par
01055                                    {\cf17 const} UNITY_COMPARISON_T compare,\par
01056                                    {\cf17 const} {\cf18 char}* msg,\par
01057                                    {\cf17 const} UNITY_LINE_TYPE lineNumber)\par
01058 \{\par
01059     {\cf18 int} failed;\par
01060 \par
01061     RETURN_IF_FAIL_OR_IGNORE;\par
01062 \par
01063     failed = 0;\par
01064 \par
01065     {\cf20 /* Checking for "not success" rather than failure to get the right result for NaN */}\par
01066     {\cf19 if} (!(actual < threshold) && (compare & UNITY_SMALLER_THAN)) \{ failed = 1; \}\par
01067     {\cf19 if} (!(actual > threshold) && (compare & UNITY_GREATER_THAN)) \{ failed = 1; \}\par
01068 \par
01069     {\cf19 if} ((compare & UNITY_EQUAL_TO) && UnityFloatsWithin(threshold * UNITY_FLOAT_PRECISION, threshold, actual)) \{ failed = 0; \}\par
01070 \par
01071     {\cf19 if} (failed)\par
01072     \{\par
01073         UnityTestResultsFailBegin(lineNumber);\par
01074         UnityPrint(UnityStrExpected);\par
01075         UnityPrintFloat(actual);\par
01076         {\cf19 if} (compare & UNITY_GREATER_THAN) \{ UnityPrint(UnityStrGt); \}\par
01077         {\cf19 if} (compare & UNITY_SMALLER_THAN) \{ UnityPrint(UnityStrLt); \}\par
01078         {\cf19 if} (compare & UNITY_EQUAL_TO)     \{ UnityPrint(UnityStrOrEqual);  \}\par
01079         UnityPrintFloat(threshold);\par
01080         UnityAddMsgIfSpecified(msg);\par
01081         UNITY_FAIL_AND_BAIL;\par
01082     \}\par
01083 \}\par
