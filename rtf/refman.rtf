01086 {\cf18 void} UnityAssertFloatSpecial({\cf17 const} UNITY_FLOAT actual,\par
01087                              {\cf17 const} {\cf18 char}* msg,\par
01088                              {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
01089                              {\cf17 const} UNITY_FLOAT_TRAIT_T style)\par
01090 \{\par
01091     {\cf17 const} {\cf18 char}* trait_names[] = \{UnityStrInf, UnityStrNegInf, UnityStrNaN, UnityStrDet\};\par
01092     UNITY_INT should_be_trait = ((UNITY_INT)style & 1);\par
01093     UNITY_INT is_trait        = !should_be_trait;\par
01094     UNITY_INT trait_index     = (UNITY_INT)(style >> 1);\par
01095 \par
01096     RETURN_IF_FAIL_OR_IGNORE;\par
01097 \par
01098     {\cf19 switch} (style)\par
01099     \{\par
01100         {\cf19 case} UNITY_FLOAT_IS_INF:\par
01101         {\cf19 case} UNITY_FLOAT_IS_NOT_INF:\par
01102             is_trait = UNITY_IS_INF(actual) && (actual > 0);\par
01103             {\cf19 break};\par
01104         {\cf19 case} UNITY_FLOAT_IS_NEG_INF:\par
01105         {\cf19 case} UNITY_FLOAT_IS_NOT_NEG_INF:\par
01106             is_trait = UNITY_IS_INF(actual) && (actual < 0);\par
01107             {\cf19 break};\par
01108 \par
01109         {\cf19 case} UNITY_FLOAT_IS_NAN:\par
01110         {\cf19 case} UNITY_FLOAT_IS_NOT_NAN:\par
01111             is_trait = UNITY_IS_NAN(actual) ? 1 : 0;\par
01112             {\cf19 break};\par
01113 \par
01114         {\cf19 case} UNITY_FLOAT_IS_DET: {\cf20 /* A determinate number is non infinite and not NaN. */}\par
01115         {\cf19 case} UNITY_FLOAT_IS_NOT_DET:\par
01116             is_trait = !UNITY_IS_INF(actual) && !UNITY_IS_NAN(actual);\par
01117             {\cf19 break};\par
01118 \par
01119         {\cf19 case} UNITY_FLOAT_INVALID_TRAIT:  {\cf20 /* Supress warning */}\par
01120         {\cf19 default}: {\cf20 /* including UNITY_FLOAT_INVALID_TRAIT */}\par
01121             trait_index = 0;\par
01122             trait_names[0] = UnityStrInvalidFloatTrait;\par
01123             {\cf19 break};\par
01124     \}\par
01125 \par
01126     {\cf19 if} (is_trait != should_be_trait)\par
01127     \{\par
01128         UnityTestResultsFailBegin(lineNumber);\par
01129         UnityPrint(UnityStrExpected);\par
01130         {\cf19 if} (!should_be_trait)\par
01131         \{\par
01132             UnityPrint(UnityStrNot);\par
01133         \}\par
01134         UnityPrint(trait_names[trait_index]);\par
01135         UnityPrint(UnityStrWas);\par
01136 {\cf21 #ifndef UNITY_EXCLUDE_FLOAT_PRINT}\par
01137         UnityPrintFloat((UNITY_DOUBLE)actual);\par
01138 {\cf21 #else}\par
01139         {\cf19 if} (should_be_trait)\par
01140         \{\par
01141             UnityPrint(UnityStrNot);\par
01142         \}\par
01143         UnityPrint(trait_names[trait_index]);\par
01144 {\cf21 #endif}\par
01145         UnityAddMsgIfSpecified(msg);\par
01146         UNITY_FAIL_AND_BAIL;\par
01147     \}\par
01148 \}\par
01149 \par
01150 {\cf21 #endif }{\cf20 /* not UNITY_EXCLUDE_FLOAT */}{\cf21 }\par
