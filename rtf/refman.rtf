00926 {\cf17 static} {\cf18 int} UnityFloatsWithin(UNITY_FLOAT delta, UNITY_FLOAT expected, UNITY_FLOAT actual)\par
00927 \{\par
00928     UNITY_FLOAT diff;\par
00929     UNITY_FLOAT_OR_DOUBLE_WITHIN(delta, expected, actual, diff);\par
00930 \}\par
