00781 {\cf18 void} UnityAssertEqualIntArray(UNITY_INTERNAL_PTR expected,\par
00782                               UNITY_INTERNAL_PTR actual,\par
00783                               {\cf17 const} UNITY_UINT32 num_elements,\par
00784                               {\cf17 const} {\cf18 char}* msg,\par
00785                               {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
00786                               {\cf17 const} UNITY_DISPLAY_STYLE_T style,\par
00787                               {\cf17 const} UNITY_FLAGS_T flags)\par
00788 \{\par
00789     UNITY_UINT32 elements  = num_elements;\par
00790     {\cf18 unsigned} {\cf18 int} length    = style & 0xF;\par
00791     {\cf18 unsigned} {\cf18 int} increment = 0;\par
00792 \par
00793     RETURN_IF_FAIL_OR_IGNORE;\par
00794 \par
00795     {\cf19 if} (num_elements == 0)\par
00796     \{\par
00797 {\cf21 #ifdef UNITY_COMPARE_PTRS_ON_ZERO_ARRAY}\par
00798         UNITY_TEST_ASSERT_EQUAL_PTR(expected, actual, lineNumber, msg);\par
00799 {\cf21 #else}\par
00800         UnityPrintPointlessAndBail();\par
00801 {\cf21 #endif}\par
00802     \}\par
00803 \par
00804     {\cf19 if} (expected == actual)\par
00805     \{\par
00806         {\cf19 return}; {\cf20 /* Both are NULL or same pointer */}\par
00807     \}\par
00808 \par
00809     {\cf19 if} (UnityIsOneArrayNull(expected, actual, lineNumber, msg))\par
00810     \{\par
00811         UNITY_FAIL_AND_BAIL;\par
00812     \}\par
00813 \par
00814     {\cf19 while} ((elements > 0) && (elements--))\par
00815     \{\par
00816         UNITY_INT expect_val;\par
00817         UNITY_INT actual_val;\par
00818 \par
00819         {\cf19 switch} (length)\par
00820         \{\par
00821             {\cf19 case} 1:\par
00822                 expect_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT8*)expected;\par
00823                 actual_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT8*)actual;\par
00824                 {\cf19 if} (style & (UNITY_DISPLAY_RANGE_UINT | UNITY_DISPLAY_RANGE_HEX))\par
00825                 \{\par
00826                     expect_val &= 0x000000FF;\par
00827                     actual_val &= 0x000000FF;\par
00828                 \}\par
00829                 increment  = {\cf17 sizeof}(UNITY_INT8);\par
00830                 {\cf19 break};\par
00831 \par
00832             {\cf19 case} 2:\par
00833                 expect_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT16*)expected;\par
00834                 actual_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT16*)actual;\par
00835                 {\cf19 if} (style & (UNITY_DISPLAY_RANGE_UINT | UNITY_DISPLAY_RANGE_HEX))\par
00836                 \{\par
00837                     expect_val &= 0x0000FFFF;\par
00838                     actual_val &= 0x0000FFFF;\par
00839                 \}\par
00840                 increment  = {\cf17 sizeof}(UNITY_INT16);\par
00841                 {\cf19 break};\par
00842 \par
00843 {\cf21 #ifdef UNITY_SUPPORT_64}\par
00844             {\cf19 case} 8:\par
00845                 expect_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT64*)expected;\par
00846                 actual_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT64*)actual;\par
00847                 increment  = {\cf17 sizeof}(UNITY_INT64);\par
00848                 {\cf19 break};\par
00849 {\cf21 #endif}\par
00850 \par
00851             {\cf19 default}: {\cf20 /* default is length 4 bytes */}\par
00852             {\cf19 case} 4:\par
00853                 expect_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT32*)expected;\par
00854                 actual_val = *(UNITY_PTR_ATTRIBUTE {\cf17 const} UNITY_INT32*)actual;\par
00855 {\cf21 #ifdef UNITY_SUPPORT_64}\par
00856                 {\cf19 if} (style & (UNITY_DISPLAY_RANGE_UINT | UNITY_DISPLAY_RANGE_HEX))\par
00857                 \{\par
00858                     expect_val &= 0x00000000FFFFFFFF;\par
00859                     actual_val &= 0x00000000FFFFFFFF;\par
00860                 \}\par
00861 {\cf21 #endif}\par
00862                 increment  = {\cf17 sizeof}(UNITY_INT32);\par
00863                 length = 4;\par
00864                 {\cf19 break};\par
00865         \}\par
00866 \par
00867         {\cf19 if} (expect_val != actual_val)\par
00868         \{\par
00869             {\cf19 if} ((style & UNITY_DISPLAY_RANGE_UINT) && (length < (UNITY_INT_WIDTH / 8)))\par
00870             \{   {\cf20 /* For UINT, remove sign extension (padding 1's) from signed type casts above */}\par
00871                 UNITY_INT mask = 1;\par
00872                 mask = (mask << 8 * length) - 1;\par
00873                 expect_val &= mask;\par
00874                 actual_val &= mask;\par
00875             \}\par
00876             UnityTestResultsFailBegin(lineNumber);\par
00877             UnityPrint(UnityStrElement);\par
00878             UnityPrintNumberUnsigned(num_elements - elements - 1);\par
00879             UnityPrint(UnityStrExpected);\par
00880             UnityPrintNumberByStyle(expect_val, style);\par
00881             UnityPrint(UnityStrWas);\par
00882             UnityPrintNumberByStyle(actual_val, style);\par
00883             UnityAddMsgIfSpecified(msg);\par
00884             UNITY_FAIL_AND_BAIL;\par
00885         \}\par
00886         {\cf20 /* Walk through array by incrementing the pointers */}\par
00887         {\cf19 if} (flags == UNITY_ARRAY_TO_ARRAY)\par
00888         \{\par
00889             expected = (UNITY_INTERNAL_PTR)(({\cf17 const} {\cf18 char}*)expected + increment);\par
00890         \}\par
00891         actual = (UNITY_INTERNAL_PTR)(({\cf17 const} {\cf18 char}*)actual + increment);\par
00892     \}\par
00893 \}\par
00894 \par
