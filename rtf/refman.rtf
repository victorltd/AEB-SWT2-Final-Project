00253 {\cf20  * basically do an itoa using as little ram as possible */}\par
00254 {\cf18 void} UnityPrintNumberUnsigned({\cf17 const} UNITY_UINT number)\par
00255 \{\par
00256     UNITY_UINT divisor = 1;\par
00257 \par
00258     {\cf20 /* figure out initial divisor */}\par
00259     {\cf19 while} (number / divisor > 9)\par
00260     \{\par
00261         divisor *= 10;\par
00262     \}\par
00263 \par
00264     {\cf20 /* now mod and print, then divide divisor */}\par
00265     {\cf19 do}\par
00266     \{\par
00267         UNITY_OUTPUT_CHAR(({\cf18 char})({\cf23 '0'} + (number / divisor % 10)));\par
00268         divisor /= 10;\par
00269     \} {\cf19 while} (divisor > 0);\par
00270 \}\par
00271 \par
