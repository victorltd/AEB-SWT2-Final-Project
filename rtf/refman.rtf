00109 {\cf17 static} UNITY_UINT UnityPrintAnsiEscapeString({\cf17 const} {\cf18 char}* {\cf18 string})\par
00110 \{\par
00111     {\cf17 const} {\cf18 char}* pch = string;\par
00112     UNITY_UINT count = 0;\par
00113 \par
00114     {\cf19 while} (*pch && (*pch != {\cf23 'm'}))\par
00115     \{\par
00116         UNITY_OUTPUT_CHAR(*pch);\par
00117         pch++;\par
00118         count++;\par
00119     \}\par
00120     UNITY_OUTPUT_CHAR({\cf23 'm'});\par
00121     count++;\par
00122 \par
00123     {\cf19 return} count;\par
00124 \}\par
00125 {\cf21 #endif}\par
00126 \par
