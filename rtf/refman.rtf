01753 {\cf18 void} UnityAssertEqualMemory(UNITY_INTERNAL_PTR expected,\par
01754                             UNITY_INTERNAL_PTR actual,\par
01755                             {\cf17 const} UNITY_UINT32 length,\par
01756                             {\cf17 const} UNITY_UINT32 num_elements,\par
01757                             {\cf17 const} {\cf18 char}* msg,\par
01758                             {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
01759                             {\cf17 const} UNITY_FLAGS_T flags)\par
01760 \{\par
01761     UNITY_PTR_ATTRIBUTE {\cf17 const} {\cf18 unsigned} {\cf18 char}* ptr_exp = (UNITY_PTR_ATTRIBUTE {\cf17 const} {\cf18 unsigned} {\cf18 char}*)expected;\par
01762     UNITY_PTR_ATTRIBUTE {\cf17 const} {\cf18 unsigned} {\cf18 char}* ptr_act = (UNITY_PTR_ATTRIBUTE {\cf17 const} {\cf18 unsigned} {\cf18 char}*)actual;\par
01763     UNITY_UINT32 elements = num_elements;\par
01764     UNITY_UINT32 bytes;\par
01765 \par
01766     RETURN_IF_FAIL_OR_IGNORE;\par
01767 \par
01768     {\cf19 if} (elements == 0)\par
01769     \{\par
01770 {\cf21 #ifdef UNITY_COMPARE_PTRS_ON_ZERO_ARRAY}\par
01771         UNITY_TEST_ASSERT_EQUAL_PTR(expected, actual, lineNumber, msg);\par
01772 {\cf21 #else}\par
01773         UnityPrintPointlessAndBail();\par
01774 {\cf21 #endif}\par
01775     \}\par
01776     {\cf19 if} (length == 0)\par
01777     \{\par
01778         UnityPrintPointlessAndBail();\par
01779     \}\par
01780 \par
01781     {\cf19 if} (expected == actual)\par
01782     \{\par
01783         {\cf19 return}; {\cf20 /* Both are NULL or same pointer */}\par
01784     \}\par
01785 \par
01786     {\cf19 if} (UnityIsOneArrayNull(expected, actual, lineNumber, msg))\par
01787     \{\par
01788         UNITY_FAIL_AND_BAIL;\par
01789     \}\par
01790 \par
01791     {\cf19 while} (elements--)\par
01792     \{\par
01793         bytes = length;\par
01794         {\cf19 while} (bytes--)\par
01795         \{\par
01796             {\cf19 if} (*ptr_exp != *ptr_act)\par
01797             \{\par
01798                 UnityTestResultsFailBegin(lineNumber);\par
01799                 UnityPrint(UnityStrMemory);\par
01800                 {\cf19 if} (num_elements > 1)\par
01801                 \{\par
01802                     UnityPrint(UnityStrElement);\par
01803                     UnityPrintNumberUnsigned(num_elements - elements - 1);\par
01804                 \}\par
01805                 UnityPrint(UnityStrByte);\par
01806                 UnityPrintNumberUnsigned(length - bytes - 1);\par
01807                 UnityPrint(UnityStrExpected);\par
01808                 UnityPrintNumberByStyle(*ptr_exp, UNITY_DISPLAY_STYLE_HEX8);\par
01809                 UnityPrint(UnityStrWas);\par
01810                 UnityPrintNumberByStyle(*ptr_act, UNITY_DISPLAY_STYLE_HEX8);\par
01811                 UnityAddMsgIfSpecified(msg);\par
01812                 UNITY_FAIL_AND_BAIL;\par
01813             \}\par
01814             ptr_exp++;\par
01815             ptr_act++;\par
01816         \}\par
01817         {\cf19 if} (flags == UNITY_ARRAY_TO_VAL)\par
01818         \{\par
01819             ptr_exp = (UNITY_PTR_ATTRIBUTE {\cf17 const} {\cf18 unsigned} {\cf18 char}*)expected;\par
01820         \}\par
01821     \}\par
01822 \}\par
