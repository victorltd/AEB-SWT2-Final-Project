01919 {\cf17 static} {\cf17 enum} UnityLengthModifier UnityLengthModifierGet({\cf17 const} {\cf18 char} *pch, {\cf18 int} *length)\par
01920 \{\par
01921     {\cf17 enum} UnityLengthModifier length_mod;\par
01922     {\cf19 switch} (pch[0])\par
01923     \{\par
01924         {\cf19 case} {\cf23 'l'}:\par
01925             \{\par
01926                 {\cf19 if} (pch[1] == {\cf23 'l'})\par
01927                 \{\par
01928                     *length = 2;\par
01929                     length_mod = UNITY_LENGTH_MODIFIER_LONG_LONG;\par
01930                 \}\par
01931                 {\cf19 else}\par
01932                 \{\par
01933                     *length = 1;\par
01934                     length_mod = UNITY_LENGTH_MODIFIER_LONG;\par
01935                 \}\par
01936                 {\cf19 break};\par
01937             \}\par
01938         {\cf19 case} {\cf23 'h'}:\par
01939             \{\par
01940                 {\cf20 // short and char are converted to int}\par
01941                 length_mod = UNITY_LENGTH_MODIFIER_NONE;\par
01942                 {\cf19 if} (pch[1] == {\cf23 'h'})\par
01943                 \{\par
01944                     *length = 2;\par
01945                 \}\par
01946                 {\cf19 else}\par
01947                 \{\par
01948                     *length = 1;\par
01949                 \}\par
01950                 {\cf19 break};\par
01951             \}\par
01952         {\cf19 case} {\cf23 'j'}:\par
01953         {\cf19 case} {\cf23 'z'}:\par
01954         {\cf19 case} {\cf23 't'}:\par
01955         {\cf19 case} {\cf23 'L'}:\par
01956             \{\par
01957                 {\cf20 // Not supported, but should gobble up the length specifier anyway}\par
01958                 length_mod = UNITY_LENGTH_MODIFIER_NONE;\par
01959                 *length = 1;\par
01960                 {\cf19 break};\par
01961             \}\par
01962         {\cf19 default}:\par
01963             \{\par
01964                 length_mod = UNITY_LENGTH_MODIFIER_NONE;\par
01965                 *length = 0;\par
01966             \}\par
01967     \}\par
01968     {\cf19 return} length_mod;\par
01969 \}\par
