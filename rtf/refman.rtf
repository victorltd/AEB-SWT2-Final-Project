00733 {\cf18 void} UnityAssertGreaterOrLessOrEqualNumber({\cf17 const} UNITY_INT threshold,\par
00734                                            {\cf17 const} UNITY_INT actual,\par
00735                                            {\cf17 const} UNITY_COMPARISON_T compare,\par
00736                                            {\cf17 const} {\cf18 char} *msg,\par
00737                                            {\cf17 const} UNITY_LINE_TYPE lineNumber,\par
00738                                            {\cf17 const} UNITY_DISPLAY_STYLE_T style)\par
00739 \{\par
00740     {\cf18 int} failed = 0;\par
00741     RETURN_IF_FAIL_OR_IGNORE;\par
00742 \par
00743     {\cf19 if} ((threshold == actual) && (compare & UNITY_EQUAL_TO)) \{ {\cf19 return}; \}\par
00744     {\cf19 if} ((threshold == actual))                               \{ failed = 1; \}\par
00745 \par
00746     {\cf19 if} ((style & UNITY_DISPLAY_RANGE_INT) == UNITY_DISPLAY_RANGE_INT)\par
00747     \{\par
00748         {\cf19 if} ((actual > threshold) && (compare & UNITY_SMALLER_THAN)) \{ failed = 1; \}\par
00749         {\cf19 if} ((actual < threshold) && (compare & UNITY_GREATER_THAN)) \{ failed = 1; \}\par
00750     \}\par
00751     {\cf19 else} {\cf20 /* UINT or HEX */}\par
00752     \{\par
00753         {\cf19 if} (((UNITY_UINT)actual > (UNITY_UINT)threshold) && (compare & UNITY_SMALLER_THAN)) \{ failed = 1; \}\par
00754         {\cf19 if} (((UNITY_UINT)actual < (UNITY_UINT)threshold) && (compare & UNITY_GREATER_THAN)) \{ failed = 1; \}\par
00755     \}\par
00756 \par
00757     {\cf19 if} (failed)\par
00758     \{\par
00759         UnityTestResultsFailBegin(lineNumber);\par
00760         UnityPrint(UnityStrExpected);\par
00761         UnityPrintNumberByStyle(actual, style);\par
00762         {\cf19 if} (compare & UNITY_GREATER_THAN) \{ UnityPrint(UnityStrGt);       \}\par
00763         {\cf19 if} (compare & UNITY_SMALLER_THAN) \{ UnityPrint(UnityStrLt);       \}\par
00764         {\cf19 if} (compare & UNITY_EQUAL_TO)     \{ UnityPrint(UnityStrOrEqual);  \}\par
00765         {\cf19 if} (compare == UNITY_NOT_EQUAL)   \{ UnityPrint(UnityStrNotEqual); \}\par
00766         UnityPrintNumberByStyle(threshold, style);\par
00767         UnityAddMsgIfSpecified(msg);\par
00768         UNITY_FAIL_AND_BAIL;\par
00769     \}\par
00770 \}\par
00771 \par
00772 {\cf21 #define UnityPrintPointlessAndBail()       \\}\par
00773 {\cf21 do \{                                       \\}\par
00774 {\cf21     UnityTestResultsFailBegin(lineNumber); \\}\par
00775 {\cf21     UnityPrint(UnityStrPointless);         \\}\par
00776 {\cf21     UnityAddMsgIfSpecified(msg);           \\}\par
00777 {\cf21     UNITY_FAIL_AND_BAIL;                   \\}\par
00778 {\cf21 \} while (0)}\par
